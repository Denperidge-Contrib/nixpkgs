{
  "name": "filebrowser-frontend",
  "version": "3.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "npm": ">=7.0.0",
    "node": ">=18.0.0"
  },
  "scripts": {
    "dev": "vite dev",
    "build": "vite build && cp -r dist/* ../backend/http/embed",
    "build-windows": "vite build && robocopy dist ../backend/http/embed /e",
    "build-docker": "vite build",
    "watch": "vite build --watch",
    "typecheck": "vue-tsc -p ./tsconfig.json --noEmit",
    "lint": "eslint --ext .js,.vue,ts src",
    "lint:fix": "eslint --fix src/",
    "i18n:sync": "node ./scripts/sync-translations.js",
    "format": "prettier --write .",
    "test": "vitest run "
  },
  "dependencies": {
    "@chenfengyuan/vue-number-input": "^2.0.1",
    "@onlyoffice/document-editor-vue": "^1.4.0",
    "@tsconfig/node22": "^22.0.2",
    "@vitejs/plugin-legacy": "^6.1.1",
    "@vue/tsconfig": "^0.7.0",
    "ace-builds": "^1.24.2",
    "autoprefixer": "^10.4.21",
    "axios": "^1.7.9",
    "clipboard": "^2.0.4",
    "css-vars-ponyfill": "^2.4.3",
    "dayjs": "^1.11.13",
    "dompurify": "^3.2.4",
    "epubjs": "^0.3.93",
    "file-loader": "^6.2.0",
    "filesize": "^10.1.6",
    "glob": "^9.3.5",
    "highlight.js": "^11.11.1",
    "js-base64": "^3.7.7",
    "jwt-decode": "^4.0.0",
    "lodash-es": "^4.17.21",
    "mammoth": "^1.9.1",
    "marked": "^15.0.6",
    "material-icons": "^1.13.14",
    "normalize.css": "^8.0.1",
    "pinia": "^3.0.3",
    "pretty-bytes": "^7.0.0",
    "qrcode.vue": "^3.4.1",
    "srt-support-for-html5-videos": "^2.6.11",
    "terser": "^5.43.0",
    "tus-js-client": "^4.3.1",
    "utif": "^3.1.0",
    "video.js": "^8.23.3",
    "videojs-hotkeys": "^0.2.30",
    "videojs-mobile-ui": "^1.1.1",
    "vue": "^3.4.21",
    "vue-demi": "^0.14.10",
    "vue-final-modal": "^4.5.5",
    "vue-i18n": "^9.10.2",
    "vue-lazyload": "^3.0.0",
    "vue-reader": "^1.2.17",
    "vue-router": "^4.3.0",
    "vue-toastification": "^2.0.0-rc.5"
  },
  "devDependencies": {
    "@intlify/eslint-plugin-vue-i18n": "^3.2.0",
    "@intlify/unplugin-vue-i18n": "^4.0.0",
    "@playwright/test": "^1.49.1",
    "@vitejs/plugin-vue": "^5.0.4",
    "@vue/eslint-config-typescript": "^13.0.0",
    "deepl-node": "^1.18.0",
    "eslint": "^8.57.0",
    "eslint-config-prettier": "^9.1.0",
    "eslint-plugin-vue": "^9.24.0",
    "fs-extra": "^11.3.0",
    "jsdom": "^25.0.1",
    "vite": "^6.2.0",
    "vite-plugin-compression2": "^1.0.0",
    "vitest": "^3.0.7",
    "vue-tsc": "^2.0.7"
  }
}
